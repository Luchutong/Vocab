# Generate once with:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-random-secret

# Local defaults. For persistent deployment, use /var/lib/vocab paths.
DATABASE=data/vocab.db
DICTIONARY_CACHE_DATABASE=data/dictionary-cache.db
ONLINE_DICTIONARY_ENABLED=1
DICTIONARY_API_TIMEOUT=8
MERRIAM_WEBSTER_API_KEY=replace-with-your-learners-dictionary-key

# Tianjin University mailbox. Port 465 avoids the outbound port 25
# restrictions commonly applied by cloud providers.
SMTP_HOST=smtp.tju.edu.cn
SMTP_PORT=465
SMTP_USERNAME=your-account@tju.edu.cn
SMTP_PASSWORD=replace-with-password-or-app-token
SMTP_SECURITY=ssl
MAIL_FROM=your-account@tju.edu.cn

# Set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
